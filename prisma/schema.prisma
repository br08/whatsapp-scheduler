generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

model ScheduledMessage {
  id         String        @id @default(cuid())
  recipient  String
  body       String
  sendAt     DateTime
  status     MessageStatus @default(PENDING)
  retryCount Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
