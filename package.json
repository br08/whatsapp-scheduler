{
  "name": "whatsapp-scheduler",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx scripts/startup.ts",
    "build": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json && mkdir -p dist/docs && cp docs/openapi.yaml dist/docs/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "stop:dev": "(pkill -f 'tsx scripts/startup.ts' || true) && (pkill -f 'tsx src/index.ts' || true) && sleep 2 && docker compose down",
    "migrate": "prisma migrate deploy",
    "infra:up": "docker compose up -d",
    "infra:init": "tsx scripts/init-evolution.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.16.1",
    "bullmq": "^5.76.8",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "msw": "^2.14.6",
    "pino-pretty": "^13.1.3",
    "redis": "^5.12.1",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
