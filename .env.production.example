# Production environment template.
# Copy this file to .env on your VPS and fill in real values.
#
# If your infra (Postgres, Redis, Evolution API) runs via docker-compose on the
# same server, use localhost with the mapped ports shown in docker-compose.yml.
# If any service is hosted remotely, replace localhost with its host/URL.

DATABASE_URL="postgresql://postgres:STRONG_PASSWORD@localhost:5432/whatsapp_scheduler"
REDIS_URL="redis://localhost:6379"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="STRONG_API_KEY"
PORT=3000
NODE_ENV=production
EVOLUTION_INSTANCE=scheduler
SENT_RETENTION_DAYS=30
FAILED_RETENTION_DAYS=7
